         .unwrap_or_default()
         .as_millis();
-    let entry_key = format!("spawn-at-{}-{}_TIME{}", std::process::id(), ts_ms, ts_ms);
+    let entry_key = format!("spawn-at-{}-{}", std::process::id(), ts_ms);
 
     let app_hint = spawn_args
         .class
@@ -1700,4 +1708,37 @@ mod tests {
         let calls = disarmed_by_spawn(failing, false).await;
         assert!(calls.is_empty(), "nothing was armed: {calls:?}");
     }
+
+    /// X11-FLASH-02i. The entry key is the value of `DESKTOP_STARTUP_ID` and
+    /// `XDG_ACTIVATION_TOKEN` (both drivers copy it verbatim; `src/platform/linux/x11/mod.rs:57-58`
+    /// and `src/platform/linux/gnome/driver.rs:317-318`). GDK reads a `_TIME<ms>` suffix there as an
+    /// X11 server timestamp: a 13-digit epoch truncated to 32 bits is a time Mutter's monotonic
+    /// clock reads as weeks in the future, the app's `_NET_ACTIVE_WINDOW` stores it as the focus
+    /// time, and the focus hand-over when the window closes is refused as "too old", which aborts
+    /// the Shell in `meta_window_unmanage`. The key must carry no timestamp at all, so that the
+    /// child receives no startup/activation variable holding one.
+    #[tokio::test]
+    async fn test_the_launch_key_carries_no_x11_timestamp() {
+        let (batch, _warnings) = arm_with_wait_flags(None, None).await;
+        let key = batch.entries[0].key.clone();
+        assert!(key.starts_with("spawn-at-"), "plain spawn-at id: {key}");
+        assert!(
+            !key.contains("_TIME"),
+            "no X11 timestamp in the startup id: {key}"
+        );
+        let rest = key.strip_prefix("spawn-at-").expect("spawn-at- prefix");
+        let (pid, ts) = rest.split_once('-').expect("spawn-at-<pid>-<ms>");
+        assert!(pid.chars().all(|c| c.is_ascii_digit()), "pid: {pid}");
+        assert!(ts.chars().all(|c| c.is_ascii_digit()), "ms since epoch: {ts}");
+        // The two variables the child gets both carry this key; neither may hold a timestamp.
+        for (name, value) in [
+            ("DESKTOP_STARTUP_ID", key.as_str()),
+            ("XDG_ACTIVATION_TOKEN", key.as_str()),
+        ] {
+            assert!(
+                !value.contains("_TIME"),
+                "{name} carries no X11 timestamp: {value}"
+            );
+        }
+    }
