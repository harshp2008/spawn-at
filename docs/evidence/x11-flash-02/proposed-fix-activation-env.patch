+    //
+    // No `_TIME<ms>` suffix: GDK takes the part after `_TIME` as an X11 server timestamp. A
+    // millisecond epoch (13 digits) truncated to 32 bits is a time Mutter's monotonic clock reads
+    // as weeks in the future; GTK then sends `_NET_ACTIVE_WINDOW` with it, Mutter stores it as the
+    // focus and user time, and the hand-over to the next window at close is refused as "too old"
+    // (`meta_display_timestamp_too_old`), which trips the `meta_window_unmanage` assertion and
+    // aborts the Shell (X11-FLASH-02i). A plain id keeps the uniqueness and the GTK3 parser fix of
+    // ccc84dd; the app then activates with CurrentTime, which Mutter resolves itself.
     let ts_ms = std::time::SystemTime::now()
