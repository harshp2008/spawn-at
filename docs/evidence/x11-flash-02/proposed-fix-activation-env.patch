diff --git a/verify/apps/gtk4-x11-close-focused.toml b/verify/apps/gtk4-x11-close-focused.toml
new file mode 100644
index 0000000..f51bb11
--- /dev/null
+++ b/verify/apps/gtk4-x11-close-focused.toml
@@ -0,0 +1,41 @@
+# PROPOSAL (X11-FLASH-02i), release-gate sessions only. Do not add to CI: it needs a real GNOME
+# Wayland session with XWayland, the gnome-text-editor package, and Desktop Icons NG
+# (ding@rastersoft.com) enabled. A failing run aborts the Shell, so it must never run in the
+# private headless Shell or anywhere unattended.
+schema_version = 2
+id = "apps/gtk4-x11-close-focused"
+category = "apps"
+title = "Close a focused forced-X11 GTK4 window and keep the Shell alive"
+description = "Launches gnome-text-editor with GDK_BACKEND=x11 through `spawn-at spawn`, so its window is XWayland and is focused when closed (GNOME focuses a new window; the runner waits until `focused` is true). Then closes it gracefully and checks that the window is gone and that the Shell that spawned it is still the same process. With the startup id carrying a `_TIME<epoch ms>` suffix this aborts the Shell in `meta_window_unmanage` when DING is enabled (X11-FLASH-02i, docs/evidence/x11-flash-02/ding-crash.md); with the plain id it must survive. Attended only."
+kind = "both"
+required = false
+tags = ["needs-real-app", "moves-focus", "!headless-safe", "human-review"]
+
+[requires]
+backend = ["gnome"]
+
+# The setup step needs `command` + `env` (today's fixture-only steps take `args`); `${w}` is the
+# window id the setup records. The runner must wait for `focused` before the action runs.
+[[setup]]
+name = "w"
+command = "gnome-text-editor"
+args = ["--new-window"]
+env = { GDK_BACKEND = "x11" }
+
+[action]
+command = "close"
+args = ["--id", "${w}"]
+
+[expect]
+exit_code = 0
+stderr_absent = ["[spawn-at] ERROR:"]
+
+[[check]]
+window = "w"
+state = "gone"
+
+# The check the harness would need: the gnome-shell process that started the window is the same
+# before and after (pid and /proc/<pid>/stat start time). A crash has to fail the spec, not just
+# show up in the journal.
+[[check]]
+shell_alive = true
